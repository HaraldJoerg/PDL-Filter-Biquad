use strict;
use warnings;

use Carp;
use Scalar::Util qw( blessed );

sub new {
    my ($class, %args) = @_;
    croak "$class\->new: missing or invalid 'samplerate' parameter"
        unless $args{samplerate};
    my $self = {
        samplerate => $args{samplerate},
        q          => $args{q} // 0.7071,  # default Butterworth
        state      => null,                # z1, z2
    };
    bless $self, $class;
}

sub process {
    my ($self, $input, $freq) = @_;
    my $output = zeroes($input);

    if (blessed $freq  and  $freq->isa('PDL')) {
        biquad_lowpass_filter(
            $input, $freq, $output, $self->{state},
            $self->{samplerate},
            $self->{q},
        );
    }
    else {
        biquad_lowpass_filter_fixed(
            $input, $output, $self->{state},
            $freq,
            $self->{samplerate},
            $self->{q},
        );
    }

    return $output;
}
EOPM

