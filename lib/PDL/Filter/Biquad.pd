#include <math.h>
');

pp_def('biquad_lowpass_filter',
    Pars => 'input(n); freq(n); [o]output(n); [o]state(m=2);',
    OtherPars => 'double samplerate; double q;',
    Code => q{
        double z1 = $state(m=>0);
        double z2 = $state(m=>1);

        double omega, alpha, b0, b1, b2, a1, a2;

        loop(n) %{
            double f = $freq();
            if (f < 1.0) f = 1.0;
            if (f > 0.499 * $COMP(samplerate)) f = 0.499 * $COMP(samplerate);

            omega = 2.0 * M_PI * f / $COMP(samplerate);
            alpha = sin(omega) / (2.0 * $COMP(q));
            double cos_omega = cos(omega);

            b0 = (1.0 - cos_omega) / 2.0;
            b1 = 1.0 - cos_omega;
            b2 = (1.0 - cos_omega) / 2.0;
            a1 = -2.0 * cos_omega;
            a2 = 1.0 - alpha;

            double a0 = 1.0 + alpha;

            b0 /= a0;
            b1 /= a0;
            b2 /= a0;
            a1 /= a0;
            a2 /= a0;

            double in = $input();
            double out = b0 * in + z1;

            z1 = b1 * in + z2 - a1 * out;
            z2 = b2 * in       - a2 * out;

            $output() = out;
        %}

        $state(m=>0) = z1;
        $state(m=>1) = z2;
    },
    Doc => <<~'EOD',
      =for ref

      Apply a biquad filter to an input ndarray with a variable cutoff
      frequency.  This is the low-level function of the module,
      exported by default.

      The arguments are:

      =over

      =item $input - A ndarray of input samples

      =item $freq - A ndarray of cutoff frequencies of same dimensions

      =item $output - A ndarray containing the filtered samples

      =item $state - A 2-element ndarray

      This array should be initialized to [0,0].  The variable is
      changed in-place and must be used for consecutive calls.

      =item $samplerate - The number of samples per second

      =item $q - The resonance at the cutoff point

      =back
      EOD
);

