use strict;
use warnings;

our $VERSION = '0.001';
pp_setversion($VERSION);

pp_addpm({At=>'Top'}, <<'EOPM');
use strict;
use warnings;

=head1 NAME

PDL::Filter::Biquad - A digital biquad filter

=head1 SYNOPSIS

  use PDL::Filter::Biquad;
  my $filter = PDL::Filter::Biquad->new(
      samplerate => 44100
  );
  my $data   = random(1000);
  my $cutoff = 1000 - sequence(1000);
  my $filtered = $filter->process($data,$cutoff);

=head1 DESCRIPTION

This module has been built as part of another, not yet released,
project.  Its purpose is to help with creating sound from the
definitions in a SoundFont .sf2 file.

Among the "generators" of SoundFont is a low-pass filter where the
cutoff frequency can vary according to a modulation envelope.  This
can not be easily done by filters provided by
L<PDL::DSP::Fir::Simple>, so I decided to try it myself, and use it as
an exercise in L<PDL::PP>.

I might want to add another low-pass filter with a constant cutoff
frequency later.

The "raw" filter function biquad_lowpass_filter is implemented in
L<PDL::PP> and wrapped by a Perl object, which hides the "state"
variables required by the filter.  Using the object, it can be used
with streaming input.

=head1 METHODS

=head2 new

The constructor of a filter object.  It takes parameters as a
key/value list.  The keys are:

=over

=item samplerate (mandatory)

This is the sample rate for the audio data to be processed by the
filter, in Hz.  Knowing the sample rate allows the cutoff frequency
of the filter to be specified in Hz, too.

=item q (optional)

This is the filter resonance, corresponding to the SoundFont generator
C<initialFilterQ>.  The default is C<>1/sqrt(2)>.

=back

=head2 process($data,$cutoff)

Takes two PDL arrays of equal length as input: The data to be
filtered, and the cutoff frequency to be applied at each data point.
Returns a PDL array of the same length containing the filtered data.

=cut

use Carp;

sub new {
    my ($class, %args) = @_;
    croak "$class\->new: missing or invalid 'samplerate' parameter"
        unless $args{samplerate};
    my $self = {
        samplerate => $args{samplerate},
        q          => $args{q} // 0.7071,  # default Butterworth
        state      => zeroes(2),           # z1, z2
    };
    bless $self, $class;
}

sub process {
    my ($self, $input, $freq) = @_;
    my $output = zeroes($input);

    biquad_lowpass_filter(
        $input, $freq, $output, $self->{state},
        $self->{samplerate},
        $self->{q},
    );

    return $output;
}
EOPM

# pp_add_exported(''); # add the list of functions
                       # to the list of exported functions

# pp_addxs('');        # add plain XS code to the XS section

# pp_add_isa(qw//);    # inheritance business: add arglist to modules @ISA

pp_addhdr('
#include <math.h>
');

pp_def('biquad_lowpass_filter',
    Pars => 'input(n); freq(n); [o]output(n); state(m);',
    OtherPars => 'double samplerate; double q;',
    Code => q{
        double z1 = $state(m=>0);
        double z2 = $state(m=>1);

        double omega, alpha, b0, b1, b2, a1, a2;

        loop(n) %{
            double f = $freq();
            if (f < 1.0) f = 1.0;
            if (f > 0.499 * $COMP(samplerate)) f = 0.499 * $COMP(samplerate);

            omega = 2.0 * M_PI * f / $COMP(samplerate);
            alpha = sin(omega) / (2.0 * $COMP(q));

            b0 = (1.0 - cos(omega)) / 2.0;
            b1 = 1.0 - cos(omega);
            b2 = (1.0 - cos(omega)) / 2.0;
            a1 = -2.0 * cos(omega);
            a2 = 1.0 - alpha;

            double a0 = 1.0 + alpha;

            b0 /= a0;
            b1 /= a0;
            b2 /= a0;
            a1 /= a0;
            a2 /= a0;

            double in = $input();
            double out = b0 * in + z1;

            z1 = b1 * in + z2 - a1 * out;
            z2 = b2 * in       - a2 * out;

            $output() = out;
        %}

        $state(m=>0) = z1;
        $state(m=>1) = z2;
    },
);

pp_done();  # you will need this to finish pp processing
